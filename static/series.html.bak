<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#F26522">
    <title>我的集資 - SELA 樂透一路發</title>
    <link rel="icon" type="image/jpeg" href="/static/logo.jpg">
    <style>
        :root {
            --sela-orange: #F26522;
            --sela-orange-dark: #D85A1E;
            --bg-primary: #FFF8F4;
            --bg-secondary: #FFF0E8;
            --bg-card: #FFFFFF;
            --text-primary: #2D2420;
            --text-secondary: #8B7355;
            --border-color: rgba(242, 101, 34, 0.12);
            --success: #16A34A;
            --shadow-md: 0 4px 16px rgba(242, 101, 34, 0.1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg-primary); 
            color: var(--text-primary);
            min-height: 100vh;
            padding-bottom: 100px;
        }
        
        /* ===== Header 統一樣式（返回鍵右上角）===== */
        .header {
            background: linear-gradient(135deg, var(--sela-orange), var(--sela-orange-dark));
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-md);
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .header .logo {
            width: 36px;
            height: 36px;
            border-radius: 8px;
        }
        .header .brand {
            color: white;
            font-size: 18px;
            font-weight: 700;
        }
        .back-btn {
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }
        
        /* ===== Main ===== */
        .main { padding: 16px; max-width: 600px; margin: 0 auto; }
        
        /* Action Bar */
        .action-bar { display: flex; gap: 10px; margin-bottom: 16px; }
        .btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
        }
        .btn-primary { background: var(--sela-orange); color: white; }
        .btn-secondary { background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-color); }
        
        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 10px;
            text-align: center;
        }
        .stat-value { font-size: 20px; font-weight: 700; color: var(--sela-orange); }
        .stat-label { font-size: 11px; color: var(--text-secondary); margin-top: 4px; }
        
        /* Series List */
        .series-list { display: flex; flex-direction: column; gap: 12px; }
        .series-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .series-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
        .series-name { font-size: 16px; font-weight: 700; }
        .series-badge {
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 6px;
            font-weight: 600;
        }
        .badge-active { background: #DCFCE7; color: #16A34A; }
        .badge-closed { background: #F3F4F6; color: #6B7280; }
        .series-info { display: flex; gap: 16px; font-size: 13px; color: var(--text-secondary); margin-bottom: 10px; }
        .series-stats { display: flex; justify-content: space-between; padding-top: 10px; border-top: 1px solid var(--border-color); }
        .series-stat { text-align: center; }
        .series-stat-value { font-size: 15px; font-weight: 700; color: var(--sela-orange); }
        .series-stat-label { font-size: 11px; color: var(--text-secondary); }
        
        /* Empty & Loading */
        .empty-state { padding: 40px 20px; text-align: center; color: var(--text-secondary); }
        .empty-icon { font-size: 48px; margin-bottom: 12px; }
        .loading { display: flex; justify-content: center; padding: 40px; }
        .spinner { width: 36px; height: 36px; border: 3px solid var(--bg-secondary); border-top-color: var(--sela-orange); border-radius: 50%; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        
        /* Modal */
        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; padding: 20px; }
        .modal.active { display: flex; }
        .modal-content { background: white; border-radius: 16px; width: 100%; max-width: 400px; max-height: 90vh; overflow-y: auto; }
        .modal-header { padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
        .modal-title { font-size: 18px; font-weight: 700; }
        .modal-close { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-secondary); }
        .modal-body { padding: 20px; }
        .form-group { margin-bottom: 16px; }
        .form-label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; }
        .form-input { width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; font-size: 16px; }
        .form-hint { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }
        .radio-group { display: flex; flex-direction: column; gap: 8px; }
        .radio-item { display: flex; align-items: center; gap: 10px; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; }
        .radio-item:has(input:checked) { background: var(--bg-secondary); border-color: var(--sela-orange); }
        .modal-footer { padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; gap: 10px; }
        .modal-footer .btn { flex: 1; }
        
        /* Toast */
        .toast { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(100px); background: var(--text-primary); color: white; padding: 12px 20px; border-radius: 10px; font-size: 14px; z-index: 2000; opacity: 0; transition: all 0.3s; }
        .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
        .toast.success { background: var(--success); }
        .toast.error { background: #DC2626; }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-left">
            <img src="/static/logo.jpg" alt="SELA" class="logo">
            <span class="brand">我的集資</span>
        </div>
        <a href="/dashboard" class="back-btn">← 返回</a>
    </header>
    
    <main class="main">
        <div class="action-bar">
            <button class="btn btn-primary" onclick="openModal('create-modal')">➕ 建立集資</button>
            <button class="btn btn-secondary" onclick="openModal('join-modal')">🔗 加入集資</button>
        </div>
        
        <div class="stats-grid" id="stats-grid">
            <div class="stat-card"><div class="stat-value" id="stat-total">0</div><div class="stat-label">參與集資</div></div>
            <div class="stat-card"><div class="stat-value" id="stat-invested">$0</div><div class="stat-label">總投入</div></div>
            <div class="stat-card"><div class="stat-value" id="stat-prize">$0</div><div class="stat-label">總獎金</div></div>
        </div>
        
        <div class="series-list" id="series-list">
            <div class="loading"><div class="spinner"></div></div>
        </div>
    </main>
    
    <!-- Create Modal -->
    <div class="modal" id="create-modal">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">建立集資</span>
                <button class="modal-close" onclick="closeModal('create-modal')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">集資名稱</label>
                    <input type="text" class="form-input" id="create-name" placeholder="例：辦公室樂透團">
                </div>
                <div class="form-group">
                    <label class="form-label">選擇彩種</label>
                    <div class="radio-group" id="lottery-types"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">每份金額</label>
                    <input type="number" class="form-input" id="create-share" placeholder="100">
                    <div class="form-hint">需為彩種價格的倍數</div>
                </div>
                <div class="form-group">
                    <label class="form-label">您的初始份額</label>
                    <input type="number" class="form-input" id="create-amount" placeholder="500">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('create-modal')">取消</button>
                <button class="btn btn-primary" onclick="createSeries()">建立</button>
            </div>
        </div>
    </div>
    
    <!-- Join Modal -->
    <div class="modal" id="join-modal">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">加入集資</span>
                <button class="modal-close" onclick="closeModal('join-modal')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">邀請碼</label>
                    <input type="text" class="form-input" id="join-code" placeholder="輸入邀請碼">
                </div>
                <div class="form-group">
                    <label class="form-label">初始份額金額</label>
                    <input type="number" class="form-input" id="join-amount" placeholder="500">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal('join-modal')">取消</button>
                <button class="btn btn-primary" onclick="joinSeries()">加入</button>
            </div>
        </div>
    </div>
    
    <div id="toast" class="toast"></div>
    
    <script src="/static/js/common.js"></script>
    <script>
        // 備援函數
        if (typeof $ === 'undefined') window.$ = id => document.getElementById(id);
        if (typeof setText === 'undefined') window.setText = (id, t) => { const e = $(id); if(e) e.textContent = t; };
        if (typeof getToken === 'undefined') window.getToken = () => { try { return localStorage.getItem('access_token'); } catch(e) { return null; } };
        if (typeof apiGet === 'undefined') window.apiGet = async (url) => { const r = await fetch('/api/v1' + url, { headers: { 'Authorization': 'Bearer ' + getToken() } }); if (!r.ok) throw new Error('API Error'); return r.json(); };
        if (typeof apiPost === 'undefined') window.apiPost = async (url, data) => { const r = await fetch('/api/v1' + url, { method: 'POST', headers: { 'Authorization': 'Bearer ' + getToken(), 'Content-Type': 'application/json' }, body: JSON.stringify(data) }); if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.detail || 'Error'); } return r.json(); };
        if (typeof formatMoney === 'undefined') window.formatMoney = (n) => Number(n||0).toLocaleString();
        if (typeof showToast === 'undefined') window.showToast = (msg, type) => { const t = $('toast'); if(t) { t.textContent = msg; t.className = 'toast ' + (type||'') + ' show'; setTimeout(() => t.classList.remove('show'), 3000); } };
        if (typeof getStatusText === 'undefined') window.getStatusText = (s) => ({ active:'進行中', closed:'已結束' }[s] || s);
        
        let lotteryTypes = [];
        const LOTTERY_PRICES = { 'power': 100, 'super': 50, 'daily539': 50 };
        
        function openModal(id) { $(id).classList.add('active'); }
        function closeModal(id) { $(id).classList.remove('active'); }
        
        async function loadLotteryTypes() {
            try {
                lotteryTypes = await apiGet('/lottery-types');
                const container = $('lottery-types');
                container.innerHTML = lotteryTypes.map(lt => `
                    <label class="radio-item">
                        <input type="radio" name="lottery-type" value="${lt.code}" ${lt.code === 'power' ? 'checked' : ''}>
                        <span>${lt.name} ($${lt.price}/注)</span>
                    </label>
                `).join('');
            } catch (e) { console.error('loadLotteryTypes:', e); }
        }
        
        async function loadSeries() {
            try {
                const data = await apiGet('/series');
                const list = $('series-list');
                
                if (!data || data.length === 0) {
                    list.innerHTML = '<div class="empty-state"><div class="empty-icon">📋</div><p>尚無集資</p><p style="font-size:13px;margin-top:8px;">點擊上方按鈕建立或加入</p></div>';
                    return;
                }
                
                let totalInvested = 0, totalPrize = 0;
                data.forEach(s => {
                    totalInvested += s.my_share || 0;
                    totalPrize += s.my_prize || 0;
                });
                
                setText('stat-total', data.length);
                setText('stat-invested', '$' + formatMoney(totalInvested));
                setText('stat-prize', '$' + formatMoney(totalPrize));
                
                list.innerHTML = data.map(s => `
                    <a href="/series/${s.id}" class="series-card">
                        <div class="series-header">
                            <div class="series-name">${s.name}</div>
                            <span class="series-badge ${s.status === 'active' ? 'badge-active' : 'badge-closed'}">${getStatusText(s.status)}</span>
                        </div>
                        <div class="series-info">
                            <span>🎰 ${s.lottery_type_name || s.lottery_type}</span>
                            <span>👥 ${s.member_count || 0} 人</span>
                        </div>
                        <div class="series-stats">
                            <div class="series-stat">
                                <div class="series-stat-value">$${formatMoney(s.my_share)}</div>
                                <div class="series-stat-label">我的份額</div>
                            </div>
                            <div class="series-stat">
                                <div class="series-stat-value">${(s.my_ratio * 100).toFixed(1)}%</div>
                                <div class="series-stat-label">佔比</div>
                            </div>
                            <div class="series-stat">
                                <div class="series-stat-value">$${formatMoney(s.total_pool)}</div>
                                <div class="series-stat-label">資金池</div>
                            </div>
                        </div>
                    </a>
                `).join('');
            } catch (e) {
                $('series-list').innerHTML = '<div class="empty-state">載入失敗</div>';
            }
        }
        
        async function createSeries() {
            const name = $('create-name').value.trim();
            const lotteryType = document.querySelector('input[name="lottery-type"]:checked')?.value;
            const shareAmount = parseInt($('create-share').value);
            const initialAmount = parseInt($('create-amount').value);
            
            if (!name || !lotteryType || !shareAmount || !initialAmount) {
                showToast('請填寫完整資料', 'error');
                return;
            }
            
            try {
                await apiPost('/series', {
                    name,
                    lottery_type: lotteryType,
                    share_amount: shareAmount,
                    initial_amount: initialAmount
                });
                showToast('建立成功！', 'success');
                closeModal('create-modal');
                loadSeries();
            } catch (e) {
                showToast(e.message || '建立失敗', 'error');
            }
        }
        
        async function joinSeries() {
            const code = $('join-code').value.trim();
            const amount = parseInt($('join-amount').value);
            
            if (!code || !amount) {
                showToast('請填寫完整資料', 'error');
                return;
            }
            
            try {
                await apiPost('/series/join', { invitation_code: code, initial_amount: amount });
                showToast('加入成功！', 'success');
                closeModal('join-modal');
                loadSeries();
            } catch (e) {
                showToast(e.message || '加入失敗', 'error');
            }
        }
        
        // 初始化
        document.addEventListener('DOMContentLoaded', () => {
            if (!getToken()) { window.location.href = '/'; return; }
            loadLotteryTypes();
            loadSeries();
        });
    </script>
</body>
</html>
